# StockMind AI Environment Configuration Example

APP_NAME=StockMind AI
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=stockmind_development_secret_key_2026

# PostgreSQL (for Docker or production):
# DATABASE_URL=postgresql+psycopg://stockmind:stockmind_dev@localhost:5432/stockmind

# SQLite fallback (default zero-dependency local execution):
DATABASE_URL=sqlite:///./stockmind.db

DEFAULT_SEED=20261022
DEFAULT_BATCH_SIZE=1000
